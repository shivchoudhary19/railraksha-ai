{
  "realm": "railraksha",
  "loginTheme": "railraksha",
  "displayName": "RailRaksha AI \u00b7 DEMO",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "verifyEmail": true,
  "resetPasswordAllowed": true,
  "rememberMe": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "failureFactor": 5,
  "maxFailureWaitSeconds": 900,
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 900,
  "ssoSessionMaxLifespan": 28800,
  "passwordPolicy": "length(14) and hashAlgorithm(argon2) and notUsername and notEmail",
  "roles": {
    "realm": [
      {
        "name": "citizen",
        "description": "RailRaksha citizen"
      },
      {
        "name": "student",
        "description": "RailRaksha student"
      },
      {
        "name": "verified_reporter",
        "description": "RailRaksha verified_reporter"
      },
      {
        "name": "analyst",
        "description": "RailRaksha analyst"
      },
      {
        "name": "soc_lead",
        "description": "RailRaksha soc_lead"
      },
      {
        "name": "rpf_cyber",
        "description": "RailRaksha rpf_cyber"
      },
      {
        "name": "asset_owner",
        "description": "RailRaksha asset_owner"
      },
      {
        "name": "partner_dev",
        "description": "RailRaksha partner_dev"
      },
      {
        "name": "admin",
        "description": "RailRaksha admin"
      },
      {
        "name": "super_admin",
        "description": "RailRaksha super_admin"
      },
      {
        "name": "default-roles-railraksha",
        "composite": true,
        "composites": {
          "realm": [
            "citizen"
          ]
        }
      }
    ]
  },
  "defaultRole": {
    "name": "default-roles-railraksha",
    "composite": true,
    "clientRole": false
  },
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "otpPolicyLookAheadWindow": 1,
  "otpPolicyInitialCounter": 0,
  "webAuthnPolicyPasswordlessRpEntityName": "RailRaksha AI",
  "webAuthnPolicyPasswordlessRpId": "localhost",
  "webAuthnPolicyPasswordlessSignatureAlgorithms": [
    "ES256",
    "RS256"
  ],
  "webAuthnPolicyPasswordlessAttestationConveyancePreference": "none",
  "webAuthnPolicyPasswordlessRequireResidentKey": "Yes",
  "webAuthnPolicyPasswordlessUserVerificationRequirement": "required",
  "webAuthnPolicyPasswordlessPasskeysEnabled": true,
  "requiredActions": [
    {
      "alias": "VERIFY_EMAIL",
      "name": "Verify Email",
      "providerId": "VERIFY_EMAIL",
      "enabled": true,
      "defaultAction": false,
      "priority": 0,
      "config": {}
    },
    {
      "alias": "UPDATE_PASSWORD",
      "name": "Update Password",
      "providerId": "UPDATE_PASSWORD",
      "enabled": true,
      "defaultAction": false,
      "priority": 10,
      "config": {}
    },
    {
      "alias": "CONFIGURE_TOTP",
      "name": "Configure OTP",
      "providerId": "CONFIGURE_TOTP",
      "enabled": true,
      "defaultAction": false,
      "priority": 20,
      "config": {}
    },
    {
      "alias": "UPDATE_PROFILE",
      "name": "Update Profile",
      "providerId": "UPDATE_PROFILE",
      "enabled": true,
      "defaultAction": false,
      "priority": 30,
      "config": {}
    },
    {
      "alias": "webauthn-register",
      "name": "Webauthn Register",
      "providerId": "webauthn-register",
      "enabled": true,
      "defaultAction": false,
      "priority": 40,
      "config": {}
    },
    {
      "alias": "webauthn-register-passwordless",
      "name": "Webauthn Register Passwordless",
      "providerId": "webauthn-register-passwordless",
      "enabled": true,
      "defaultAction": false,
      "priority": 50,
      "config": {}
    }
  ],
  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "security@railraksha.test",
    "fromDisplayName": "RailRaksha DEMO",
    "ssl": "false",
    "starttls": "false",
    "auth": "false"
  },
  "eventsEnabled": true,
  "eventsExpiration": 15552000,
  "eventsListeners": [
    "jboss-logging"
  ],
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": false,
  "clients": [
    {
      "clientId": "railraksha-web",
      "name": "RailRaksha AI",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${OIDC_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "implicitFlowEnabled": false,
      "redirectUris": [
        "http://localhost:3000/api/auth/callback"
      ],
      "webOrigins": [
        "http://localhost:3000"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/en##http://localhost:3000/hi"
      },
      "defaultClientScopes": [
        "basic",
        "profile",
        "email",
        "roles"
      ],
      "protocolMappers": [
        {
          "name": "API audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "railraksha-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "railraksha-api",
      "enabled": true,
      "protocol": "openid-connect",
      "bearerOnly": true,
      "publicClient": false
    }
  ],
